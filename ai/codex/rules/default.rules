# Codex exec policy rules. Rules apply to requests that run outside the
# sandbox; hooks and sandboxing still cover in-sandbox commands.

prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-Rf", "-rF"]],
    decision = "forbidden",
    justification = "Use `trash` instead of recursive force deletion.",
    match = ["rm -rf build", "rm -fr tmp"],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "prompt",
    justification = "sudo requires explicit human review.",
    match = ["sudo make install"],
)

prefix_rule(
    pattern = ["mkfs"],
    decision = "forbidden",
    justification = "Filesystem formatting commands are not allowed from Codex.",
    match = ["mkfs /dev/disk1"],
)

prefix_rule(
    pattern = ["dd"],
    decision = "forbidden",
    justification = "Raw disk write commands are not allowed from Codex.",
    match = ["dd if=image.iso of=/dev/disk1"],
)

prefix_rule(
    pattern = ["git", "add", "--force"],
    decision = "forbidden",
    justification = "Do not force-add ignored files from Codex. Use plain `git add`, or have the user force-add intentionally.",
    match = ["git add --force docs/.ai/report.md"],
)

prefix_rule(
    pattern = ["git", "add", "-f"],
    decision = "forbidden",
    justification = "Do not force-add ignored files from Codex. Use plain `git add`, or have the user force-add intentionally.",
    match = ["git add -f docs/.ai/report.md"],
)

prefix_rule(
    pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "push"],
    decision = "forbidden",
    justification = "Do not run `git push` from Codex; the user pushes manually.",
    match = ["git push", "git push origin feature", "git push -u origin feature", "/usr/bin/git push", "/opt/homebrew/bin/git push"],
)

# Prefix rules cannot skip arbitrary values of -C/-c/--git-dir; the hook parses
# those forms and blocks a push behind them. No catch-all Git rule: a prompt
# rule becomes a rejection under approval_policy "never", which broke plain
# `git status` for unattended workers.

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Do not force-push unless the user explicitly requested it.",
    match = ["git push --force origin feature"],
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Do not force-push unless the user explicitly requested it.",
    match = ["git push -f origin feature"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Do not discard work unless the user explicitly requested it.",
    match = ["git reset --hard HEAD"],
)

prefix_rule(
    pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "please"],
    decision = "forbidden",
    justification = "`git please` is an alias for `git push --force-with-lease`; the user pushes manually.",
    match = ["git please", "/opt/homebrew/bin/git please origin feature"],
)

# Xcode/SwiftPM and compiler macros may start their own macOS sandbox, which
# fails inside Seatbelt. These build commands run trusted package manifests,
# plugins, build phases and tests on the host. Keep other Swift subcommands,
# arbitrary xcrun tools, and project wrappers such as just sandboxed.
prefix_rule(pattern = [["xcodebuild", "/usr/bin/xcodebuild"]], decision = "allow")
prefix_rule(
    pattern = [["xcrun", "/usr/bin/xcrun"], ["xcodebuild", "swiftc"]],
    decision = "allow",
)
prefix_rule(pattern = [["swiftc", "/usr/bin/swiftc"]], decision = "allow")
prefix_rule(
    pattern = [["swift", "/usr/bin/swift"], ["build", "test"]],
    decision = "allow",
)
prefix_rule(
    pattern = [["xcrun", "/usr/bin/xcrun"], "swift", ["build", "test"]],
    decision = "allow",
)
prefix_rule(
    pattern = [["swift", "/usr/bin/swift"], "package",
               ["resolve", "describe", "dump-package", "show-dependencies"]],
    decision = "allow",
)
prefix_rule(
    pattern = [["xcrun", "/usr/bin/xcrun"], "swift", "package",
               ["resolve", "describe", "dump-package", "show-dependencies"]],
    decision = "allow",
)

# headroom is the read-only host admission check. Seatbelt hides the swap and
# memory-pressure sysctls, so direct calls to this installed binary need the host.
# Keep PATH-resolved lookalikes and shell wrappers outside this allowance.
prefix_rule(
    pattern = ["/opt/homebrew/bin/headroom"],
    decision = "allow",
    match = ["/opt/homebrew/bin/headroom", "/opt/homebrew/bin/headroom --format json"],
    not_match = ["headroom", "/tmp/headroom", "/opt/homebrew/bin/headroom-helper"],
)

# gcloud needs its own and SSH credential stores, which stay unreadable inside
# the sandbox. The user accepted unattended gcloud commands, including compute
# ssh with a remote command. Cargo builds stay sandboxed.
prefix_rule(pattern = ["gcloud"], decision = "allow")

# Public entry points of the installed skills. These command approvals preserve
# the selected sandbox, credential restrictions, and each skill's authority and
# account gates. Keep exact paths and interpreter forms: no directory glob,
# arbitrary Python/shell command, internal lane helper, or generic guarded-job
# runner receives host approval here. That runner's payload needs its own grant.
skill_root = "/Users/blacktop/.agents/skills/"
skill_shell_entrypoints = [
    skill_root + "design-director/scripts/seed.sh",
    skill_root + "design-director/scripts/screenshot.sh",
    skill_root + "tmux-pm/scripts/checkup-timer.sh",
    skill_root + "tmux-pm/scripts/dispatch-worker.sh",
    skill_root + "tmux-pm/scripts/launch-pane.sh",
    skill_root + "tmux-pm/scripts/submit-prompt.sh",
    skill_root + "tmux-pm/scripts/validate-directive.sh",
    skill_root + "tmux-pm/scripts/worker-gate.sh",
    skill_root + "tmux-pm/scripts/worktree-lifecycle.sh",
    skill_root + "tmux-pm/scripts/test-tmux-pm.sh",
]
skill_python_entrypoints = [
    skill_root + "design-director/scripts/check-assessment.py",
    skill_root + "high-tide/scripts/context_percent.py",
    skill_root + "rust-profiling/scripts/analyze_profile.py",
    skill_root + "save-session/scripts/save_session.py",
    skill_root + "swiftui-expert-skill/scripts/analyze_trace.py",
    skill_root + "swiftui-expert-skill/scripts/record_trace.py",
    skill_root + "tmux-pm/scripts/test-integration.py",
    skill_root + "tmux-pm/scripts/test-guarded-jobs.py",
    skill_root + ".system/imagegen/scripts/image_gen.py",
    skill_root + ".system/imagegen/scripts/remove_chroma_key.py",
    skill_root + ".system/skill-creator/scripts/generate_openai_yaml.py",
    skill_root + ".system/skill-creator/scripts/init_skill.py",
    skill_root + ".system/skill-creator/scripts/quick_validate.py",
    skill_root + ".system/skill-installer/scripts/install-skill-from-github.py",
    skill_root + ".system/skill-installer/scripts/list-skills.py",
]
skill_node_entrypoints = [
    skill_root + "design-taste-frontend/scripts/assets.mjs",
    skill_root + "design-taste-frontend/scripts/draw.mjs",
    skill_root + "design-taste-frontend/scripts/inspect.mjs",
    skill_root + "design-taste-frontend/scripts/lint.mjs",
    skill_root + ".system/openai-docs/scripts/fetch-codex-manual.mjs",
]
prefix_rule(
    pattern = [skill_shell_entrypoints + skill_python_entrypoints + skill_node_entrypoints],
    decision = "allow",
)
prefix_rule(
    pattern = [["sh", "/bin/sh", "bash", "/bin/bash", "/opt/homebrew/bin/bash"], skill_shell_entrypoints],
    decision = "allow",
)
prefix_rule(
    pattern = [["python3", "/usr/bin/python3", "/opt/homebrew/bin/python3"], skill_python_entrypoints],
    decision = "allow",
)
prefix_rule(
    pattern = [["node", "/usr/bin/node", "/opt/homebrew/bin/node"], skill_node_entrypoints],
    decision = "allow",
)

# Local Git metadata is writable. Retain these named escalation allowances for
# platform integrations that still need them. The list is not `git` alone:
# global options (`-c alias.x=!cmd`,
# `-c core.pager=cmd`) and `rebase -x`, `fetch`/`pull --upload-pack` run
# arbitrary commands, so those forms stay sandboxed. Forbidden rules above win.
prefix_rule(
    pattern = [
        ["git", "/usr/bin/git", "/opt/homebrew/bin/git"],
        ["add", "commit", "branch", "checkout", "switch", "restore", "rm", "mv",
         "worktree", "stash", "merge", "cherry-pick", "revert", "tag"],
    ],
    decision = "allow",
    match = ["git add -A", "git commit -m x", "git worktree add -b topic ../wt main"],
    not_match = ["git status", "git -c alias.x=!sh x", "git rebase -x sh main"],
)

# This fixed value disables the fsmonitor subprocess. Do not generalize the
# configuration key/value or allow another global option before the subcommand.
prefix_rule(
    pattern = [
        ["git", "/usr/bin/git", "/opt/homebrew/bin/git"],
        "-c", "core.fsmonitor=false", ["add", "commit"],
    ],
    decision = "allow",
    match = ["git -c core.fsmonitor=false add -- file.go", "git -c core.fsmonitor=false commit --no-gpg-sign -m checkpoint"],
    not_match = ["git -c core.fsmonitor=sh add file.go", "git -c core.fsmonitor=false -c alias.x=!sh x", "git -c core.fsmonitor=false push"],
)

prefix_rule(
    pattern = [
        ["git", "/usr/bin/git", "/opt/homebrew/bin/git"],
        "-c", "core.fsmonitor=false", "add", ["-f", "--force"],
    ],
    decision = "forbidden",
    justification = "Disabling fsmonitor must not permit force-adding ignored files.",
    match = ["git -c core.fsmonitor=false add -f ignored", "git -c core.fsmonitor=false add --force ignored"],
)

# The shared hook handles global options, aliases and reordered flags as well.
prefix_rule(
    pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "branch", ["-D", "-f", "--force"]],
    decision = "forbidden",
    justification = "Forced branch deletion or replacement is user-run; use safe branch operations.",
)
prefix_rule(
    pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "worktree", "remove", ["--force", "-f", "-ff"]],
    decision = "forbidden",
    justification = "Do not force-remove a worktree; preserve its work and let the PM remove it when clean.",
)
