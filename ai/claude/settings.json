{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "enableAllProjectMcpServers": false,
  "tui": "fullscreen",
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Never run git push, or any alias or wrapper that pushes; the user pushes manually.",
      "Never read, print, copy or transmit credential stores, keychains, SSH or GPG keys, API tokens or .env files.",
      "Never bypass safeguards to complete an unrelated task. Changes to sandbox settings, permission rules and hooks require an explicit user request to change that configuration."
    ],
    "allow": [
      "$defaults",
      "Routine local development in the assigned checkout: edits, builds, tests, dependency downloads, Git staging and commits, local branches, and PM-owned merges, non-forced worktree creation/removal, stale worktree-registration pruning, and git branch -d for merged branches. Network destinations are controlled by the host firewall, not an agent domain allowlist. This includes the installed tmux-pm worktree-lifecycle helper and recoverable deletion with trash, even when these commands use configured sandbox exclusions. Writes to the repository shared Git metadata and configured shared caches are part of this work. This does not permit pushes, destructive operations, secret access or edits to another worker source checkout."
    ],
    "soft_deny": [
      "$defaults",
      "Never retry a command outside the sandbox only to reach a network host or path the sandbox blocked, unless the task plainly requires it.",
      "Never delete or overwrite files outside the current repository, except Git metadata required for an authorized checkpoint of the assigned worktree branch or PM-owned integration and worktree lifecycle. This exception does not permit edits to another worker's files or branch, Git configuration, hooks, credential stores, force-adds, or pushes."
    ]
  },
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DO_NOT_TRACK": "1",
    "HOMEBREW_NO_ANALYTICS": "1",
    "SEMGREP_SEND_METRICS": "off",
    "KACHE_RECORD_SESSIONS": "0",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "core.fsmonitor",
    "GIT_CONFIG_VALUE_0": "false"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "ask": [
      "Bash(git commit *--no-verify*)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git worktree remove *--force*)",
      "Bash(gh release delete*)",
      "Bash(cargo publish*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(uv publish*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(diskutil erase*)",
      "Bash(diskutil partitionDisk*)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Bash(curl *|bash*)",
      "Bash(curl *| bash*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(export -p*)",
      "Bash(git push*)",
      "Bash(/usr/bin/git push*)",
      "Bash(/opt/homebrew/bin/git push*)",
      "Bash(git please*)",
      "Bash(git reset --hard*)",
      "Bash(git add --force*)",
      "Bash(git add * --force*)",
      "Bash(git add -f*)",
      "Bash(git add * -f*)",
      "Bash(gh repo delete*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.config/fish/config.fish)",
      "Edit(~/.config/fish/locals.fish)",
      "Edit(~/.gitconfig)",
      "Edit(~/.ssh/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/op/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.npm/**)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/.cargo/credentials.toml)",
      "Read(~/.codex/auth.json)",
      "Read(~/.codex-team/auth.json)",
      "Read(~/.codex-api/auth.json)",
      "Read(~/.config/fish/locals.fish)",
      "Read(~/Library/Keychains/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "docker *",
      "gcloud *",
      "xcodebuild *",
      "/opt/homebrew/bin/headroom *",
      "git commit *",
      "git merge *",
      "git rebase *",
      "git cherry-pick *",
      "git revert *",
      "git tag *",
      "git branch *",
      "git -C * branch *",
      "/usr/bin/git branch *",
      "/usr/bin/git -C * branch *",
      "/opt/homebrew/bin/git branch *",
      "/opt/homebrew/bin/git -C * branch *",
      "git worktree *",
      "git -C * worktree *",
      "/usr/bin/git worktree *",
      "/usr/bin/git -C * worktree *",
      "/opt/homebrew/bin/git worktree *",
      "/opt/homebrew/bin/git -C * worktree *",
      "~/.agents/skills/tmux-pm/scripts/worktree-lifecycle.sh *",
      "/Users/blacktop/.agents/skills/tmux-pm/scripts/worktree-lifecycle.sh *",
      "/Users/blacktop/Developer/Mine/blacktop/private-skills/skills/tmux-pm/scripts/worktree-lifecycle.sh *",
      "trash *",
      "/usr/bin/trash *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/Library/Caches/go-build",
        "~/Library/Caches/staticcheck",
        "~/Library/Caches/golangci-lint",
        "~/Library/Caches/gopls",
        "~/go/pkg/mod",
        "~/go/pkg/sumdb",
        "~/.cargo/registry",
        "~/.cargo/git",
        "~/.cargo/.package-cache",
        "~/.cargo/.package-cache-mutate",
        "~/.cargo/.global-cache",
        "~/.cargo/.global-cache-journal",
        "~/.cargo/advisory-db",
        "~/.cargo/advisory-db..lock",
        "~/.cargo/advisory-dbs",
        "~/.rustup",
        "~/Library/Caches/kache",
        "~/Library/Caches/cargo-vet",
        "~/Library/Caches/org.rust-lang.miri",
        "~/.cache/nextest",
        "~/.local/state/nextest",
        "~/.cache/uv",
        "~/.cache/zig",
        "~/.cache/prek",
        "~/.bun/install/cache",
        "~/.local/share/uv",
        "~/Library/pnpm",
        "~/Library/Caches/org.swift.swiftpm"
      ],
      "denyWrite": [
        "~/.config/fish",
        "~/.cargo/bin",
        "~/go/bin",
        "~/.local/bin"
      ]
    },
    "credentials": {
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "CARGO_REGISTRY_TOKEN", "mode": "deny" },
        { "name": "OPENAI_API_KEY", "mode": "deny" },
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" },
        { "name": "ELEVENLABS_API_KEY", "mode": "deny" },
        { "name": "GEMINI_API_KEY", "mode": "deny" },
        { "name": "CONTEXT7_API_KEY", "mode": "deny" },
        { "name": "EXA_API_KEY", "mode": "deny" }
      ]
    },
    "network": {
      "allowUnixSockets": ["/private/tmp/tmux-501/default", "/var/run/docker.sock", "/Users/blacktop/Library/Caches/kache/daemon.sock"],
      "allowLocalBinding": true,
      "allowedDomains": [
        "*"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(jq -r '.tool_input.command'); if echo \"$CMD\" | grep -qiE '(^|;[[:space:]]*|&&[[:space:]]*|[|][|][[:space:]]*|[|][[:space:]]*)rm[[:space:]]'; then echo 'BLOCKED: Use trash instead of rm, as its own Bash call: trash /absolute/path. Files go to macOS Trash and are recoverable.' >&2; exit 2; fi"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/hooks/block-chained-trash.py\""
          },
          {
            "type": "command",
            "command": "CMD=$(jq -r '.tool_input.command'); if echo \"$CMD\" | grep -qiE 'locals\\.fish'; then echo 'BLOCKED: locals.fish contains sensitive secrets — never read or display its contents' >&2; exit 2; fi"
          },
          {
            "type": "command",
            "command": "CMD=$(jq -r '.tool_input.command'); if echo \"$CMD\" | grep -qiE '(^|;|&&|\\|\\||\\|)\\s*(env|printenv|set)\\s*(\\||;|&&|$|>)'; then echo 'BLOCKED: Environment may contain secrets — do not dump env vars' >&2; exit 2; fi"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.agents/hooks/block-git-push.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.agents/hooks/block-git-force-add.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__mcp-tts__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.agents/hooks/notify-pane.sh\" claude",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.agents/hooks/notify-attention.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.agents/hooks/notify-attention.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "plansDirectory": "./docs/.ai/plans",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "code-improver@trailofbits": true,
    "c-review@trailofbits": true,
    "audit-context-building@trailofbits": true,
    "dimensional-analysis@trailofbits": true,
    "differential-review@trailofbits": true
  }
}
