{
  "$schema": "https://antigravity.google/schemas/v1/settings.json",
  "notifications": true,
  "permissions": {
    "allow": [
      "command(rex)",
      "mcp(mcp-tts/say_tts)",
      "mcp(mcp-tts/voice_tts)"
    ],
    "ask": [
      "command(git clean)",
      "command(git restore)",
      "command(git checkout --)",
      "command(git branch -D)",
      "command(git stash drop)",
      "command(git stash clear)",
      "command(git worktree remove)",
      "command(gh release delete)",
      "command(cargo publish)",
      "command(npm publish)",
      "command(pnpm publish)",
      "command(uv publish)"
    ],
    "deny": [
      "command(rm -rf)",
      "command(rm -fr)",
      "command(sudo)",
      "command(mkfs)",
      "command(dd)",
      "command(diskutil eraseDisk)",
      "command(diskutil eraseVolume)",
      "command(diskutil partitionDisk)",
      "command(env)",
      "command(printenv)",
      "command(export -p)",
      "command(git push)",
      "command(/usr/bin/git push)",
      "command(/opt/homebrew/bin/git push)",
      "command(git please)",
      "command(git reset --hard)",
      "command(git add --force)",
      "command(git add -f)",
      "command(gh repo delete)",
      "write_file(${HOME}/.bashrc)",
      "write_file(${HOME}/.zshrc)",
      "write_file(${HOME}/.zprofile)",
      "write_file(${HOME}/.config/fish/config.fish)",
      "write_file(${HOME}/.gitconfig)",
      "read_file(${HOME}/.ssh)",
      "read_file(${HOME}/.gnupg)",
      "read_file(${HOME}/.aws)",
      "read_file(${HOME}/.azure)",
      "read_file(${HOME}/.config/gcloud)",
      "read_file(${HOME}/.config/gh)",
      "read_file(${HOME}/.config/op)",
      "read_file(${HOME}/.git-credentials)",
      "read_file(${HOME}/.netrc)",
      "read_file(${HOME}/.docker/config.json)",
      "read_file(${HOME}/.kube)",
      "read_file(${HOME}/.npmrc)",
      "read_file(${HOME}/.npm)",
      "read_file(${HOME}/.pypirc)",
      "read_file(${HOME}/.gem/credentials)",
      "read_file(${HOME}/.cargo/credentials.toml)",
      "read_file(${HOME}/.codex/auth.json)",
      "read_file(${HOME}/.codex-team/auth.json)",
      "read_file(${HOME}/.codex-api/auth.json)",
      "read_file(${HOME}/.gemini/oauth_creds.json)",
      "read_file(${HOME}/.gemini/gemini-credentials.json)",
      "read_file(${HOME}/.config/fish/locals.fish)",
      "read_file(${HOME}/Library/Keychains)"
    ]
  }
}
